pipeline {
    agent {
        label 'worker'
    }
    tools{
        maven 'maven'
    }
    environment{
        aws_cred = 'aws-credential'

    }

    stages {
        stage('checkout') {
            steps {
               
        git branch: 'main', url: 'https://github.com/sakshipatode235-ai/student-ui.git'
        sh 'echo "checkout successful"'
        
            }
            
        }
        stage('build'){

            steps{
                sh 'mvn clean package'
            }
        }

        stage('artifact to s3'){
            steps{
                sh'''
        
                aws s3 cp target/*.war s3://artifact-jenkins-s3/Artifacts/student.war
                '''
            }
        }
    }
}
