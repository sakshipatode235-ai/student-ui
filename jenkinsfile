pipeline {
    agent {
        label 'worker'
    }
    tools{
        maven 'maven'
    }

    stages {
        stage('checkout') {
            steps {
               
        git branch: 'main', url: 'https://github.com/sakshipatode235-ai/student-ui.git'
        sh 'echo "checkout successful"'
        
            }
            
        }
        stage('build'){

            steps{
                sh 'mvn clean package'
            }
        }
    }
}
