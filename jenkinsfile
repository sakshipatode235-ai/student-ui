pipeline {
    agent {
        label 'worker'
    }

    stages {
        stage('checkout') {
            steps {
               sh'''
        git branch: 'main', url: 'https://github.com/sakshipatode235-ai/student-ui.git'
        echo "checkout successful"
        '''
            }
            
        }
        stage('build'){

            steps{
                sh 'mvn clean package'
            }
        }
    }
}
